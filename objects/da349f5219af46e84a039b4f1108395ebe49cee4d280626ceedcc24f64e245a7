  "compositionGrammar": {
    "schemaVersion": 1,
    "purpose": "Give every map part one legal composition layer and make strange rooms bend a coherent law instead of bypassing one",
    "stages": [
      {
        "id": "topology",
        "order": 1,
        "law": "Own exact floor, void, room, segment, and route truth."
      },
      {
        "id": "navigation",
        "order": 2,
        "law": "Own apertures, arrivals, transitions, door state, and all required approaches."
      },
      {
        "id": "founded-structure",
        "order": 3,
        "law": "Own full-height walls, freestanding structural terrain, columns, piers, and founded void edges."
      },
      {
        "id": "room-purpose",
        "order": 4,
        "law": "One coherence owner states the room's main formal and playable sentence."
      },
      {
        "id": "surface-field",
        "order": 5,
        "law": "One base field per room floor or founded wall bay; phase changes occur in owned clusters."
      },
      {
        "id": "architectural-feature",
        "order": 6,
        "law": "One compatible focal treatment claims a host; portals own and suppress their whole opening."
      },
      {
        "id": "causal-overlay",
        "order": 7,
        "law": "Damage, repair, damp, soot, age, and mutation require a named cause and cannot rewrite occupancy."
      },
      {
        "id": "opportunity-field",
        "order": 8,
        "law": "Candidate domains overlap visibly; candidates are not content and never move after nomination."
      },
      {
        "id": "mounted-fixture",
        "order": 9,
        "law": "Every fixture uses an exact wall, column, prop, ceiling, or grid-vertex host."
      },
      {
        "id": "blocking-composition",
        "order": 10,
        "law": "Selected props and structures own exact footprints, approaches, and whole-room economy."
      },
      {
        "id": "nonblocking-dressing",
        "order": 11,
        "law": "Dressing needs an owned host or explicit zero-cell address and cannot change play truth."
      },
      {
        "id": "presentation",
        "order": 12,
        "law": "Camera and disclosure modifiers occur last and never alter mechanics or founded identity."
      }
    ],
    "hardInvariants": [
      "A lower layer cannot be repaired, hidden, or contradicted by a higher layer.",
      "One host has one primary owner; overlays attach to that owner and do not compete with it.",
      "A portal owns its aperture, leaf, posts, arch, threshold, state sweep, and approaches as one measured assembly.",
      "A full-height wall remains a full-height wall unless an authored destruction state changes it.",
      "Playerless Beauty, Studio, gallery, and profile captures render every full-height wall fully opaque.",
      "Only a real player occlusion may dynamically retain a one-foot opaque course and fade the remaining full-height silhouette to 25 percent opacity.",
      "Blocking footprints, routes, arrivals, interactions, light hosts, and persistent states may never be invented or visually repaired by the renderer."
    ],
    "roomModes": {
      "coherent": {
        "rule": "One coherence magnet owns purpose, structural rhythm, surface history, light cadence, prop composition, and protected negative space; incompatible lawful candidates are suppressed.",
        "proof": "The room reads as one sentence from the gameplay camera even when its geometry is impossible or overtly modular."
      },
      "frayed": {
        "rule": "Begin with a complete coherent contract, preserve every hard invariant, then record a bounded fray operation against one readable edge of that contract.",
        "proof": "A reviewer can name the underlying rule, the exact place it frays, and the cause or formal operation that made it fray.",
        "budget": "Frequency and exact operation count remain open; fray is explicit packet state, never a hidden stack of independent random rolls."
      }
    },
    "allowedFrayOperations": [
      "cadence interruption: omit, reverse, or offset one member of an otherwise readable row, circle, pair, or rank",
      "boundary migration: let one material, age, or mutation field cross an explicit seam into the neighboring owned cluster",
      "causal rupture: interrupt symmetry with one readable damage, repair, occupation, or supernatural event",
      "foreign intrusion: insert one incompatible module only when its seam, displacement, and spatial consequence are explicit",
      "dislocated composition: shift or turn one member while retaining the parent pattern, legal footprint, and route economy"
    ],
    "forbiddenFrayOperations": [
      "door leaves that do not fit their aperture or arch",
      "full-height walls replaced by rubble-height presentation geometry",
      "independent tile-scale material, feature, damage, repair, and age rolls stacked without ownership",
      "objects sharing an exclusive footprint or fixtures leaving their exact mount",
      "route, arrival, interaction, retreat, cover, sight, disclosure, or persistence lies",
      "camera-near or focus-room proxies masquerading as a player occlusion"
    ]
  },
