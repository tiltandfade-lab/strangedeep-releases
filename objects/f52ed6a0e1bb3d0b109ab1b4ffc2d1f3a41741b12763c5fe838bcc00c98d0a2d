   "cheapPatterns": [
    "pitted",
    "patched",
    "hide",
    "crackle",
    "grain",
    "pebble",
    "peened",
    "tooled",
    "facet",
    "leaded"
   ],
   "hammeredMetal": true,
   "why": "\"the rule is against cheap procedural bumps (noise dents, pits, grain, crack relief), not relief as such\": relief from these pattern kinds, and the hammered dents every plain or patched metal gets, is cheap procedural noise. A rolling material carrying it must be named in keep with its reason; Material Maker and authored relief (tooled scales, fan inlay, weave, quilt, mail) is not on the list.",
